@namespace Sandbox
@using Sandbox.UI;
@inherits PanelComponent

<root>
@if ( _open )
{
	<div class="ap-backdrop" @onclick="@ClosePanel" />

	<div class="ap-window">

		<!-- ── En-tête ─────────────────────────────────────── -->
		<div class="ap-header">
			<div class="ap-header-left">
				<label class="ap-title">Panneau Administration</label>
				<label class="ap-role-badge ap-role-@_myRole.ToString().ToLower()">@_myRole.GetLabel()</label>
			</div>
			<Button Icon="refresh" class="ap-icon-btn" @onclick="@Refresh" />
			<Button Icon="close"   class="ap-icon-btn ap-close" @onclick="@ClosePanel" />
		</div>

		<!-- ── Onglets ─────────────────────────────────────── -->
		<div class="ap-tabs">
			<div class="ap-tab @(_tab == Tab.Players ? "active" : "")"
			     @onclick="@(() => SelectTab( Tab.Players ))">
				<label>Joueurs (@_onlinePlayers.Count)</label>
			</div>

			@if ( _myRole.CanAdmin() )
			{
				<div class="ap-tab @(_tab == Tab.Bans ? "active" : "")"
				     @onclick="@(() => SelectTab( Tab.Bans ))">
					<label>Bans (@_activeBans.Count)</label>
				</div>
			}

			<div class="ap-tab @(_tab == Tab.Logs ? "active" : "")"
			     @onclick="@(() => SelectTab( Tab.Logs ))">
				<label>Logs</label>
			</div>
		</div>

		<!-- ── Contenu ─────────────────────────────────────── -->
		<div class="ap-body">

			@* ══════════════════════════════════════════════
			   ONGLET : JOUEURS
			   ══════════════════════════════════════════════ *@
			@if ( _tab == Tab.Players )
			{
				<div class="ap-search-row">
					<TabTextEntry class="ap-input ap-search-input"
					              Placeholder="Rechercher un joueur…"
					              Value:bind=@_search />
				</div>

				<div class="ap-player-list">
				@{
					var filtered = _onlinePlayers
						.Where( p => string.IsNullOrEmpty( _search )
						          || p.DisplayName.Contains( _search, System.StringComparison.OrdinalIgnoreCase ) )
						.ToList();
				}

				@if ( filtered.Count == 0 )
				{
					<div class="ap-empty"><label>Aucun joueur trouvé.</label></div>
				}

				@foreach ( var p in filtered )
				{
					var isSelected = _selected == p.SteamId;
					var isSelf     = p.SteamId == (Connection.Local != null ? (long)Connection.Local.SteamId.Value : 0L);

					<div class="ap-player-row @(isSelected ? "selected" : "")"
					     @onclick="@(() => TogglePlayer( p.SteamId ))">
						<div class="ap-player-info">
							<label class="ap-player-name">@p.DisplayName</label>
							@if ( p.IsHost )
							{
								<label class="ap-badge ap-badge-host">HOST</label>
							}
							<label class="ap-badge ap-role-@p.Role.ToString().ToLower()">@p.Role.GetLabel()</label>
						</div>
						<label class="ap-player-id">@p.SteamId</label>
					</div>

					@if ( isSelected && !isSelf )
					{
						<div class="ap-actions-panel">

							@if ( _myRole.CanModerate() )
							{
								<div class="ap-action-row">
									<label class="ap-action-label">Kick</label>
									<TabTextEntry class="ap-input ap-reason-input"
									              Placeholder="Raison du kick…"
									              Value:bind=@_kickReason />
									<Button Text="Kick" Icon="logout"
									        class="ap-btn ap-btn-warn"
									        @onclick="@(() => DoKick( p.SteamId ))" />
								</div>
							}

							@if ( _myRole.CanTempBan() )
							{
								<div class="ap-action-row">
									<label class="ap-action-label">Ban</label>
									<TabTextEntry class="ap-input ap-reason-input"
									              Placeholder="Raison du ban…"
									              Value:bind=@_banReason />
									<TabTextEntry class="ap-input ap-duration-input"
									              Placeholder="Durée (min, 0=perm)"
									              Value:bind=@_banDuration />
									<Button Text="Bannir" Icon="gavel"
									        class="ap-btn ap-btn-danger"
									        @onclick="@(() => DoBan( p.SteamId ))" />
								</div>
							}

							@if ( _myRole.CanAdmin() )
							{
								<div class="ap-action-row">
									<label class="ap-action-label">Argent</label>
									<TabTextEntry class="ap-input ap-money-input"
									              Placeholder="Montant ($)"
									              Value:bind=@_moneyAmount />
									<Button Text="Définir" Icon="payments"
									        class="ap-btn ap-btn-info"
									        @onclick="@(() => DoSetMoney( p.SteamId ))" />
								</div>

								<div class="ap-action-section">
									<label class="ap-action-label">Job</label>
									<div class="ap-job-grid">
									@foreach ( var job in JobDefinition.GetAll() )
									{
										<Button Text="@job.Title"
										        class="ap-btn ap-btn-job"
										        @onclick="@(() => DoSetJob( p.SteamId, job.ResourcePath ))" />
									}
									</div>
								</div>

								<div class="ap-action-section">
									<label class="ap-action-label">Rôle</label>
									<div class="ap-role-grid">
										<Button Text="Player"     class="ap-btn ap-btn-role" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.Player ))" />
										<Button Text="Support"    class="ap-btn ap-btn-role" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.Support ))" />
										<Button Text="Modérateur" class="ap-btn ap-btn-role" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.Moderator ))" />
										<Button Text="SuperModo"  class="ap-btn ap-btn-role" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.SuperModerator ))" />
										@if ( _myRole.IsFounder() )
										{
											<Button Text="Admin"     class="ap-btn ap-btn-role ap-btn-danger" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.Admin ))" />
											<Button Text="Fondateur" class="ap-btn ap-btn-role ap-btn-danger" @onclick="@(() => DoSetRole( p.SteamId, StaffRole.Founder ))" />
										}
									</div>
								</div>

								<div class="ap-action-row">
									<label class="ap-action-label">VIP</label>
									<Button Text="Activer"   Icon="star"        class="ap-btn ap-btn-vip"  @onclick="@(() => DoGiveVip( p.SteamId, true ))" />
									<Button Text="Retirer"   Icon="star_border"  class="ap-btn ap-btn-warn" @onclick="@(() => DoGiveVip( p.SteamId, false ))" />
								</div>
							}

						</div>
					}
				}
				</div>
			}

			@* ══════════════════════════════════════════════
			   ONGLET : BANS
			   ══════════════════════════════════════════════ *@
			@if ( _tab == Tab.Bans && _myRole.CanAdmin() )
			{
				@if ( _activeBans.Count == 0 )
				{
					<div class="ap-empty"><label>Aucun ban actif.</label></div>
				}
				else
				{
					<div class="ap-ban-list">
						<div class="ap-ban-header-row">
							<label class="ap-ban-col ap-ban-col-name">Joueur</label>
							<label class="ap-ban-col ap-ban-col-reason">Raison</label>
							<label class="ap-ban-col ap-ban-col-admin">Admin</label>
							<label class="ap-ban-col ap-ban-col-expire">Expire</label>
							<label class="ap-ban-col ap-ban-col-action"></label>
						</div>
						@foreach ( var ban in _activeBans )
						{
							<div class="ap-ban-row">
								<label class="ap-ban-col ap-ban-col-name">@ban.DisplayName</label>
								<label class="ap-ban-col ap-ban-col-reason">@ban.Reason</label>
								<label class="ap-ban-col ap-ban-col-admin">@(ban.AdminName ?? "Système")</label>
								<label class="ap-ban-col ap-ban-col-expire">@(ban.ExpiresAt.HasValue ? ban.ExpiresAt.Value.ToString("dd/MM HH:mm") : "Permanent")</label>
								<div class="ap-ban-col ap-ban-col-action">
									<Button Text="Débannir" Icon="lock_open"
									        class="ap-btn ap-btn-info"
									        @onclick="@(() => DoUnban( ban.Id ))" />
								</div>
							</div>
						}
					</div>
				}
			}

			@* ══════════════════════════════════════════════
			   ONGLET : LOGS
			   ══════════════════════════════════════════════ *@
			@if ( _tab == Tab.Logs )
			{
				@if ( _recentLogs.Count == 0 )
				{
					<div class="ap-empty"><label>Aucun log disponible.</label></div>
				}
				else
				{
					<div class="ap-log-list">
						<div class="ap-log-header-row">
							<label class="ap-log-col ap-log-col-time">Heure</label>
							<label class="ap-log-col ap-log-col-admin">Admin</label>
							<label class="ap-log-col ap-log-col-action">Action</label>
							<label class="ap-log-col ap-log-col-target">Cible</label>
							<label class="ap-log-col ap-log-col-details">Détails</label>
						</div>
						@foreach ( var log in Enumerable.Reverse( _recentLogs ) )
						{
							<div class="ap-log-row">
								<label class="ap-log-col ap-log-col-time">@log.CreatedAt.ToString("HH:mm:ss")</label>
								<label class="ap-log-col ap-log-col-admin">@log.AdminName</label>
								<label class="ap-log-col ap-log-col-action">@log.Action</label>
								<label class="ap-log-col ap-log-col-target">@log.TargetName</label>
								<label class="ap-log-col ap-log-col-details">@log.Details</label>
							</div>
						}
					</div>
				}
			}

		</div>
	</div>
}
</root>

@code
{
	protected override int BuildHash()
	{
		if ( !_open ) return 0;
		var h = new System.HashCode();
		h.Add( _open );
		h.Add( (int)_tab );
		h.Add( _selected );
		h.Add( _revision );
		h.Add( _search );
		h.Add( (int)_myRole );
		return h.ToHashCode();
	}
}
